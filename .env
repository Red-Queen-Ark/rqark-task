PROJECT_NAME=rqark

REDIS_SERVER=localhost
REDIS_PORT=6379

# Data cloud
DATA_CLOUD_URL=http://localhost:7302

# Tasks
# Must match INTERNAL_TOKEN in rqark-data-cloud: the claim and finalize
# endpoints are guarded by it.
INTERNAL_TOKEN=0a3be1ef5e090053bf78701be8c0fefdc955e5e878d26eed3ed1e26a0f5e9080
TASK_RUN_TIMEOUT=600
TASKS_ENABLED=true
TASK_TICK_SECONDS=30
TASK_CONCURRENCY=1

# Memory
# A run token only reaches its own session, so the memory writer cannot read
# the account switches or write a row. Turning it off keeps it from spending a
# model call on a write that will be refused.
RQARK_MEMORY_AUTO_WRITE=0
